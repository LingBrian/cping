{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPing",
  "version": "1.1.0",
  "identifier": "com.cping.gui",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C网群PING工具",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.png"],
    "android": {
      "minSdkVersion": 24
    }
  }
}
