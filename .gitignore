# Rust
/target
**/*.rs.bk

# Node / 前端
node_modules/
dist/
*.local

# Tauri
/src-tauri/target
/src-tauri/gen

# 日志与临时产物
*.log
*.tmp

# Kotlin/Gradle 会话临时文件（构建产生，不应入库）
**/.kotlin/

# 归集好的发布产物（体积大，不入库；由构建脚本生成）
release/

# cargo vendor 的离线依赖快照（用于无外网环境复现 Linux 构建；
# 体积大且可由 `cargo vendor vendor-offline` 随时重建，不入库）
vendor-offline/
vendor/

# 编辑器
.vscode/
.idea/

# 验证用的临时截图（点开头），避免被 git add -A 误收进仓库
docs/images/.*.png
